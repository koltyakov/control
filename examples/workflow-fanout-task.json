{
  "id": "rotate-logs-001",
  "capability": "workflow.run",
  "args": {
    "maxParallel": 4,
    "steps": [
      {
        "name": "rotate",
        "target": { "each": { "labels": { "env": "prod" }, "capability": "exec.run" } },
        "task": {
          "id": "rotate-logs-001-rotate",
          "capability": "exec.run",
          "args": { "command": "logrotate", "args": ["--force", "/etc/logrotate.conf"] }
        }
      },
      {
        "name": "summarize",
        "target": { "select": { "capability": "exec.run", "maxCpuPercent": 50 } },
        "needs": ["rotate"],
        "task": {
          "capability": "exec.run",
          "args": { "command": "echo", "args": ["every prod machine rotated its logs"] }
        }
      },
      {
        "name": "unlock",
        "target": { "each": { "labels": { "env": "prod" }, "capability": "exec.run" } },
        "when": "always",
        "needs": ["rotate"],
        "task": {
          "capability": "exec.run",
          "args": { "command": "rm", "args": ["-f", "/tmp/rotate-logs-001.lock"] }
        }
      }
    ]
  }
}
